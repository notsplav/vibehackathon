# Кто проверяет утверждения: gemini (Gemini + Google Search) или ollama (локальная модель + Ollama Web Search).
LLM_PROVIDER=

# --- Ollama ---
# Адрес локальной Ollama (по умолчанию http://127.0.0.1:11434).
OLLAMA_URL=
# Локальная модель (по умолчанию qwen3:14b; скачать: ollama pull qwen3:14b).
OLLAMA_MODEL=
# Ключ Ollama Web Search (бесплатный аккаунт: https://ollama.com/settings/keys). Нужен для поиска источников.
OLLAMA_API_KEY=
# Размер контекста модели в токенах (по умолчанию 16384).
OLLAMA_NUM_CTX=

# --- Gemini ---
# Ключ Gemini: только для локального сервера, у каждого свой.
GEMINI_API_KEY=
# Модель Gemini (по умолчанию gemini-3.8-flash).
GEMINI_MODEL=

# Порт локального сервера на 127.0.0.1 (по умолчанию 8787).
PORT=
# Путь к SQLite относительно папки server/ (по умолчанию data/factcheck.sqlite, в .gitignore).
DB_PATH=
# Разрешённые Origin расширения через запятую: chrome-extension://<id>. По умолчанию — ID расширения из репозитория.
ALLOWED_ORIGINS=
# Параллельных проверок claims (по умолчанию 2 для Gemini и 1 для Ollama).
CHECK_CONCURRENCY=
# Символов статьи на один запрос извлечения claims (по умолчанию 8000).
CLAIM_CHUNK_CHARS=
# Максимальный размер запроса в байтах (по умолчанию 2000000).
MAX_BODY_BYTES=

# Необязательно: путь к локальной копии эталонной статьи для тестов извлечения (по умолчанию ищется в fixtures/local/).
TEST_ARTICLE_HTML=
