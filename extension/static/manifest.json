{
  "manifest_version": 3,
  "name": "Сверка",
  "short_name": "Сверка",
  "version": "0.1.0",
  "description": "Сверка утверждений статьи с источниками: локальный сервер, модель и поиск.",
  "minimum_chrome_version": "116",
  "key": "",
  "action": {
    "default_title": "Сверка — проверить статью"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus",
    "nativeMessaging"
  ]
}
