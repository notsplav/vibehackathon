{
  "name": "vibehackathon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "extension",
    "host"
  ],
  "scripts": {
    "install:host": "node host/scripts/install.ts",
    "build:extension": "npm run build -w extension",
    "typecheck": "tsc -p shared && tsc -p core && tsc -p host && tsc -p extension",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
