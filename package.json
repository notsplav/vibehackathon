{
  "name": "vibehackathon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "extension",
    "server"
  ],
  "scripts": {
    "build:extension": "npm run build -w extension",
    "dev:server": "npm run dev -w server",
    "start:server": "npm run start -w server",
    "probe:gemini": "npm run probe:gemini -w server",
    "probe:ollama": "npm run probe:ollama -w server",
    "searxng:up": "npm run searxng:up -w server",
    "searxng:down": "npm run searxng:down -w server",
    "searxng:status": "npm run searxng:status -w server",
    "typecheck": "tsc -p shared && tsc -p extension && tsc -p server",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
